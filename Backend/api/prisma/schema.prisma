generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  KEYCLOAK
}

enum ContentType {
  MOVIE
  SERIES
  DOCUMENTARY
  SHORT
}

enum ContentStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  displayName  String?
  avatarUrl    String?
  passwordHash String?
  keycloakId   String?   @unique
  role         Role      @default(USER)
  isOnline     Boolean   @default(false)
  lastSeen     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts         AuthAccount[]
  ratings          Rating[]
  favorites        Favorite[]
  playbackProgress PlaybackProgress[]
  chatMessages     ChatMessage[]
  comments         Comment[]
  commentLikes     CommentLike[]
  announcements    Announcement[]
  bannedRecord     BannedUser?

  @@map("users")
}

model AuthAccount {
  id           String       @id @default(uuid())
  userId       String
  provider     AuthProvider
  providerId   String
  accessToken  String?      @db.Text
  refreshToken String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("auth_accounts")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contents ContentCategory[]

  @@map("categories")
}

model Content {
  id               String        @id @default(uuid())
  externalId       String?       @unique
  title            String
  slug             String        @unique
  synopsis         String        @db.Text
  aiSynopsis       String?       @db.Text
  coverUrl         String?
  bannerUrl        String?
  type             ContentType   @default(MOVIE)
  status           ContentStatus @default(PUBLISHED)
  releaseYear      Int?
  duration         String?
  durationMinutes  Int?
  country          String?
  director         String?
  screenplay       String?
  music            String?
  cinematography   String?
  cast             String?
  production       String?
  narrator         String?
  audioDescription Boolean       @default(true)
  dubbing          String?
  genreRaw         String?
  filmaffinityUrl  String?
  audioUrl         String?
  audioUrls        String[]      @default([])
  averageRating    Float         @default(0.0)
  ratingsCount     Int           @default(0)
  viewsCount       Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  categories       ContentCategory[]
  seasons          Season[]
  ratings          Rating[]
  favorites        Favorite[]
  playbackProgress PlaybackProgress[]
  comments         Comment[]

  @@index([type])
  @@index([status])
  @@index([releaseYear])
  @@map("contents")
}

model ContentCategory {
  contentId  String
  categoryId String

  content  Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([contentId, categoryId])
  @@map("content_categories")
}

model Season {
  id           String   @id @default(uuid())
  contentId    String
  seasonNumber Int
  title        String?
  overview     String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  content  Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([contentId, seasonNumber])
  @@map("seasons")
}

model Episode {
  id              String   @id @default(uuid())
  seasonId        String
  episodeNumber   Int
  title           String
  synopsis        String?  @db.Text
  aiSynopsis      String?  @db.Text
  audioUrl        String
  durationMinutes Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  season           Season             @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playbackProgress PlaybackProgress[]

  @@unique([seasonId, episodeNumber])
  @@map("episodes")
}

model PlaybackProgress {
  id           String   @id @default(uuid())
  userId       String
  contentId    String
  episodeId    String?
  partIndex    Int      @default(0)
  episodeIndex Int      @default(0)
  positionMs   BigInt   @default(0)
  durationMs   BigInt   @default(0)
  isCompleted  Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@unique([userId, contentId, partIndex, episodeIndex])
  @@index([userId, updatedAt])
  @@map("playback_progress")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("favorites")
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  score     Int
  review    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("ratings")
}

model Comment {
  id           String   @id @default(uuid())
  userId       String
  contentId    String
  partIndex    Int      @default(0)
  episodeIndex Int      @default(0)
  commentText  String   @db.Text
  likesCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  likes   CommentLike[]

  @@index([contentId, partIndex, episodeIndex])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("chat_messages")
}

model Announcement {
  id        String   @id @default(uuid())
  authorId  String
  title     String?
  content   String   @db.Text
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("announcements")
}

model BannedUser {
  id          String    @id @default(uuid())
  userId      String    @unique
  reason      String    @default("Infracción de las reglas de la comunidad")
  bannedById  String
  bannedUntil DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("banned_users")
}

model AppConfig {
  key         String   @id
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@map("app_configs")
}
