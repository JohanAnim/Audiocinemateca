generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum ContentType {
  MOVIE
  SERIES
  DOCUMENTARY
}

enum ContentStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  displayName  String?
  avatarUrl    String?
  passwordHash String?
  keycloakId   String?   @unique
  role         Role      @default(USER)
  isOnline     Boolean   @default(false)
  lastSeen     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ratings          Rating[]
  favorites        Favorite[]
  playbackProgress PlaybackProgress[]
  chatMessages     ChatMessage[]

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contents ContentCategory[]

  @@map("categories")
}

model Content {
  id               String        @id @default(uuid())
  title            String
  slug             String        @unique
  synopsis         String        @db.Text
  aiSynopsis       String?       @db.Text
  coverUrl         String?
  bannerUrl        String?
  type             ContentType   @default(MOVIE)
  status           ContentStatus @default(PUBLISHED)
  releaseYear      Int?
  durationMinutes  Int?
  country          String?
  audioUrl         String?
  narrator         String?
  audioDescription Boolean       @default(true)
  dubbing          String?
  averageRating    Float         @default(0.0)
  ratingsCount     Int           @default(0)
  viewsCount       Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  categories       ContentCategory[]
  seasons          Season[]
  ratings          Rating[]
  favorites        Favorite[]
  playbackProgress PlaybackProgress[]

  @@map("contents")
}

model ContentCategory {
  contentId  String
  categoryId String

  content  Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([contentId, categoryId])
  @@map("content_categories")
}

model Season {
  id           String   @id @default(uuid())
  contentId    String
  seasonNumber Int
  title        String?
  overview     String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  content  Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([contentId, seasonNumber])
  @@map("seasons")
}

model Episode {
  id              String   @id @default(uuid())
  seasonId        String
  episodeNumber   Int
  title           String
  synopsis        String?  @db.Text
  aiSynopsis      String?  @db.Text
  audioUrl        String
  durationMinutes Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  season           Season             @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playbackProgress PlaybackProgress[]

  @@unique([seasonId, episodeNumber])
  @@map("episodes")
}

model PlaybackProgress {
  id          String   @id @default(uuid())
  userId      String
  contentId   String
  episodeId   String?
  positionMs  BigInt   @default(0)
  durationMs  BigInt   @default(0)
  isCompleted Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, episodeId])
  @@map("playback_progress")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("favorites")
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  score     Int
  review    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("ratings")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model AppConfig {
  key         String   @id
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@map("app_configs")
}
