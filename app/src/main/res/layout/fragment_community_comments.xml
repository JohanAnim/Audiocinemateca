<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:importantForAccessibility="no"
    android:focusable="false"
    android:clickable="false">

    <!-- Cabecera ajustada al mínimo -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:importantForAccessibility="no"
        android:focusable="false"
        android:clickable="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filter_comments_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Filtrar por: Más recientes"
            app:icon="@drawable/ic_more_vert"
            app:iconGravity="end"
            android:importantForAccessibility="yes"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Lista que ocupa el resto del espacio -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/community_comments_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="yes"
        android:focusable="true"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_comment" />

    <!-- Estos solo existen para el lector si están visibles -->
    <ProgressBar
        android:id="@+id/community_comments_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/empty_community_comments_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="20dp"
        android:text="No se encontraron comentarios."
        android:visibility="gone"
        android:importantForAccessibility="no" />

</LinearLayout>
