<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".presentation.account.AccountFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/account_header"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="?attr/colorPrimary"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/header_username"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textColor="?attr/colorOnPrimary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="56dp"
                android:layout_marginTop="12dp"
                android:tooltipText="Toca para ver tu perfil"
                android:contentDescription="Conectado actualmente, toca para ver tu perfil"
                android:focusable="true"
                android:clickable="true"
                app:layout_constraintBottom_toTopOf="@id/account_improvement_notice"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/account_improvement_notice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="¡La mejora de tu cuenta ya está disponible! Toca tu nombre para ver más información."
                android:textColor="?attr/colorOnPrimary"
                android:textSize="12sp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="56dp"
                android:layout_marginTop="16dp"
                android:alpha="0.9"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/header_username"
                tools:text="Sincronización en curso..."
                tools:visibility="visible" />

                        <ImageButton
                            android:id="@+id/share_app_button"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Compartir aplicación"
                            android:src="@drawable/ic_lists"
                            app:tint="?attr/colorOnPrimary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/settings_icon_button"
                            app:layout_constraintTop_toTopOf="parent" />
            
                        <ImageButton
                            android:id="@+id/settings_icon_button"            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Configuración"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/account_header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/download_count_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Esta versión de la app tiene X descargas"
                android:textSize="16sp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="80dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:visibility="visible"/>

            <Button
                android:id="@+id/my_account_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Mi cuenta (Audiocinemateca.com)"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="80dp"
                app:layout_constraintTop_toBottomOf="@id/download_count_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <Button
                android:id="@+id/about_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Acerca de"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/my_account_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <Button
                android:id="@+id/donate_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Apoyar el proyecto (Donaciones)"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/about_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <Button
                android:id="@+id/novedades_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Novedades de la App"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/donate_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <Button
                android:id="@+id/releases_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Historial de Versiones (GitHub)"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/novedades_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <Button
                android:id="@+id/telegram_group_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grupo de Telegram"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/releases_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Grupo de Información de Versiones -->
            <TextView
                android:id="@+id/catalog_version_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Catálogo: [Fecha]"
                android:textSize="14sp"
                android:layout_marginTop="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/telegram_group_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/check_updates_button"/>

            <Button
                android:id="@+id/check_updates_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actualizar"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/catalog_version_text"
                app:layout_constraintBottom_toBottomOf="@id/catalog_version_text"/>

            <TextView
                android:id="@+id/app_version_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="App Versión: [Versión]"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintTop_toBottomOf="@id/catalog_version_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
