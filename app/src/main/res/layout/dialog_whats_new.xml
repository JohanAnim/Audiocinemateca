<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/changelog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Novedades de esta versión!"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/changelog_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="10"
        android:scrollbars="vertical"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/donation_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¡Apoya el Crecimiento de la App!"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/donation_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Si disfrutas de Audiocinemateca, tu apoyo es fundamental para mantener los servidores y seguir mejorando. Elige la opción que prefieras:"
        android:textAppearance="?attr/textAppearanceBody2"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/donate_official_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💖 Donación Oficial (PayPal)"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/donate_direct_button"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="☕ Invitame un café (PayPal.me)"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/later_button"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="En otro momento"
        android:layout_gravity="end"/>

</LinearLayout>