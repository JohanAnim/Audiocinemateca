<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/announcement_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="2dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/announcement_admin_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="?attr/colorPrimary"
                tools:text="Johan Administrador anunció:" />

            <TextView
                android:id="@+id/announcement_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="16sp"
                android:ellipsize="end"
                android:maxLines="3"
                tools:text="Este es un mensaje importante que se puede leer al tocarlo..." />

            <TextView
                android:id="@+id/announcement_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="Hoy a las 15:30" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_react_announcement"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:padding="8dp"
            app:icon="@drawable/ic_thumb_up"
            app:iconTint="?attr/colorPrimary"
            android:contentDescription="Reaccionar a este anuncio" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>