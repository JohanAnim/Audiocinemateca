<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <!-- Controles de Reproducción Superiores -->
    <LinearLayout
        android:id="@+id/playback_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="128dp" 
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Botón de Pista Anterior (Personalizado) -->
        <ImageButton
            android:id="@+id/custom_prev_media"
            style="@style/ExoMediaButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Anterior"
            android:src="@drawable/ic_previous" />

        <!-- Botón de Retroceso Rápido (Estándar de ExoPlayer) -->
        <ImageButton
            android:id="@id/exo_rew"
            style="@style/ExoMediaButton.Rewind"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Retroceder" />

        <!-- Botón de Reproducir/Pausar (Estándar de ExoPlayer) -->
        <ImageButton
            android:id="@id/exo_play_pause"
            style="@style/ExoMediaButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="Reproducir/Pausar" />

        <!-- Botón de Avance Rápido (Estándar de ExoPlayer) -->
        <ImageButton
            android:id="@id/exo_ffwd"
            style="@style/ExoMediaButton.FastForward"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Adelantar" />

        <!-- Botón de Siguiente Pista (Personalizado) -->
        <ImageButton
            android:id="@+id/custom_next_media"
            style="@style/ExoMediaButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Siguiente"
            android:src="@drawable/ic_next" />

    </LinearLayout>

    <!-- Barra de Tiempo y Duración -->
    <LinearLayout
        android:id="@+id/time_bar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playback_controls">

        <!-- Tiempo de Reproducción Actual (Estándar de ExoPlayer) -->
        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:importantForAccessibility="no"
            tools:text="01:23" />

        <!-- Barra de Progreso (Estándar de ExoPlayer) -->
        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:contentDescription="Control de tiempo"
            app:buffered_color="#99FFFFFF"
            app:played_color="#FF0000"
            app:unplayed_color="#4DFFFFFF" />

        <!-- Duración Total del Medio (Estándar de ExoPlayer) -->
        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            tools:text="05:00" />

    </LinearLayout>

    <!-- Contenedor de Votos (Me gusta / No me gusta / Compartir) -->
    <LinearLayout
        android:id="@+id/vote_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_vote_pill"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/time_bar_container">

        <!-- Botón Me Gusta -->
        <LinearLayout
            android:id="@+id/like_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/like_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_thumb_up"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/like_count_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                tools:text="15" />
        </LinearLayout>

        <!-- Separador Vertical -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#4DFFFFFF"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- Botón No Me Gusta -->
        <LinearLayout
            android:id="@+id/dislike_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/dislike_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_thumb_down"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/dislike_count_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                tools:text="2" />
        </LinearLayout>

        <!-- Separador Vertical -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#4DFFFFFF"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- Botón Compartir -->
        <LinearLayout
            android:id="@+id/share_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Compartir"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/share_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_share"
                app:tint="@android:color/white" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Compartir"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Contenedor para la Tarjeta de Clasificación de Contenido por IA (Compose) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_ai_content_rating"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vote_container" />

    <!-- Sección de Comentarios (Vista Previa) -->
    <LinearLayout
        android:id="@+id/comments_preview_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="96dp" 
        android:background="@drawable/bg_vote_pill"
        android:orientation="vertical"
        android:padding="32dp" 
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Encabezado y Botón -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/comments_header_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Comentarios: 0"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_comments"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comentar"
                android:textColor="@android:color/white"
                app:strokeColor="#4DFFFFFF"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

        </LinearLayout>

        <!-- Etiqueta del comentario -->
        <TextView
            android:id="@+id/latest_comment_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" 
            android:text="Nadie ha comentado esto aún."
            android:textColor="#CCFFFFFF"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>