<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Nombre y Dice -->
    <TextView
        android:id="@+id/comment_user_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:importantForAccessibility="no"
        android:textColor="?android:attr/textColorPrimary"
        tools:text="Johan Dice:" />

    <!-- Texto del Comentario (En línea nueva) -->
    <TextView
        android:id="@+id/comment_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="16sp"
        android:importantForAccessibility="no"
        android:textColor="?android:attr/textColorPrimary"
        tools:text="Este es un comentario de ejemplo que ocupa varias líneas si es necesario." />

    <!-- Pie del Comentario: Fecha y Botón Like -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/comment_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:importantForAccessibility="no"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="30 dic. 2025, 15:30" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/comment_like_button"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            app:icon="@drawable/ic_thumb_up"
            app:iconSize="18dp"
            app:iconTint="?android:attr/textColorSecondary"
            tools:text="5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/comment_reply_button"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:text="Responder"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            app:iconTint="?android:attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/comment_menu_button"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            app:icon="@drawable/ic_more_vert"
            app:iconTint="?android:attr/textColorSecondary"
            android:contentDescription="Más opciones" />

    </LinearLayout>

    <!-- Divisor sutil al final -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#1A000000" />

</LinearLayout>
