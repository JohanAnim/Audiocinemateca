<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Motor y Voz">
        
        <ListPreference
            app:key="tts_engine"
            app:title="Motor de Texto a Voz"
            app:summary="El motor a usar (reinicia las voces al cambiar)."
            app:defaultValue="system_default" />

        <ListPreference
            app:key="tts_language"
            app:title="Idioma de la voz"
            app:summary="Selecciona el idioma para filtrar las voces."
            app:defaultValue="system_default" />
            
        <ListPreference
            app:key="tts_voice"
            app:title="Voz"
            app:summary="Selecciona la voz para el motor actual."
            app:defaultValue="default_voice" />

    </PreferenceCategory>

    <PreferenceCategory app:title="Velocidad y Tono">
        
        <SeekBarPreference
            app:key="tts_rate_seek"
            app:title="Velocidad de voz"
            app:min="1"
            android:max="20"
            app:defaultValue="10"
            app:showSeekBarValue="true" />
            
        <SeekBarPreference
            app:key="tts_pitch_seek"
            app:title="Tono de voz"
            app:min="1"
            android:max="20"
            app:defaultValue="10"
            app:showSeekBarValue="true" />
            
        <Preference
            app:key="tts_test_button"
            app:title="Hacer prueba de voz"
            app:summary="Escucha una demostración de los ajustes actuales." />

        <Preference
            app:selectable="false"
            app:summary="Nota: Puedes detener el discurso de la voz en cualquier momento deslizando un dedo hacia abajo en cualquier parte de la aplicación." />

    </PreferenceCategory>

</PreferenceScreen>
